<Window x:Class="BookStore.Windows.ProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStore.Windows"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Список товаров"
        Height="760" Width="1180"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Height="48" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="ООО «ЧитайГород» — Каталог книг"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserFullNameTextBlock"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="UserRoleTextBlock"
                                   FontSize="12"
                                   Foreground="#333333"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button x:Name="LogoutButton"
                            Content="Выйти"
                            Padding="14,6"
                            Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="FilterPanelBorder"
                Grid.Row="1"
                Background="#F4F8F8"
                BorderBrush="{StaticResource SecondaryBackgroundBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Поиск:" FontSize="12" Margin="0,0,0,2"/>
                    <TextBox x:Name="SearchTextBox"
                             Height="34"
                             TextChanged="SearchTextBox_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Сортировка:" FontSize="12" Margin="0,0,0,2"/>
                    <ComboBox x:Name="SortComboBox"
                              Height="34"
                              SelectionChanged="SortComboBox_SelectionChanged">
                        <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                        <ComboBoxItem Content="По цене (по возрастанию)"/>
                        <ComboBoxItem Content="По цене (по убыванию)"/>
                        <ComboBoxItem Content="По остатку на складе (по возрастанию)"/>
                        <ComboBoxItem Content="По остатку на складе (по убыванию)"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Фильтр по скидке:" FontSize="12" Margin="0,0,0,2"/>
                    <ComboBox x:Name="DiscountFilterComboBox"
                              Height="34"
                              SelectionChanged="DiscountFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="Все диапазоны" IsSelected="True"/>
                        <ComboBoxItem Content="0–12,99%"/>
                        <ComboBoxItem Content="13–16,99%"/>
                        <ComboBoxItem Content="17% и более"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock x:Name="RecordsCountTextBlock"
                           Grid.Column="3"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,6"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
            </Grid>
        </Border>

        <ListBox x:Name="ProductsListBox"
                 Grid.Row="2"
                 Margin="16,12"
                 BorderThickness="0"
                 Background="Transparent"
                 HorizontalContentAlignment="Stretch"
                 SelectionChanged="ProductsListBox_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,10"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding CardBackground}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="125" Height="150"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    Background="#FFFFFF"
                                    VerticalAlignment="Center">
                                <Image Source="{Binding ProductImage}" Stretch="Uniform"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0">
                                <TextBlock FontSize="16" FontWeight="Bold" TextWrapping="Wrap">
                                    <Run Text="{Binding Category.Name}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding Name}"/>
                                </TextBlock>

                                <TextBlock Text="{Binding Description, TargetNullValue='Описание отсутствует'}"
                                           TextWrapping="Wrap"
                                           MaxHeight="42"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="#333333"
                                           Margin="0,4,0,6"/>

                                <TextBlock>
                                    <Run Text="Производитель: " FontWeight="Bold"/>
                                    <Run Text="{Binding Publisher.Name}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Поставщик: " FontWeight="Bold"/>
                                    <Run Text="{Binding Author.Name}"/>
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Цена: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Price, StringFormat={}{0:N2} руб.}"
                                               TextDecorations="{Binding OldPriceDecorations}"
                                               Foreground="{Binding OldPriceForeground}"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N2} руб.}"
                                               Visibility="{Binding DiscountPriceVisibility}"
                                               Foreground="#000000"
                                               FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock>
                                    <Run Text="Единица измерения: " FontWeight="Bold"/>
                                    <Run Text="{Binding Unit.Name}"/>
                                </TextBlock>

                                <TextBlock>
                                    <Run Text="Количество на складе: " FontWeight="Bold"/>
                                    <Run Text="{Binding StockQuantity}"/>
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1,0,0,0"
                                    Padding="10,0,0,0"
                                    VerticalAlignment="Center">
                            </Border>

                            
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border x:Name="BottomActionsBorder"
        Grid.Row="3"
        Background="{StaticResource SecondaryBackgroundBrush}"
        Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OrdersButton"
            Content="Заказы"
            Margin="0,0,10,0"
            Click="OrdersButton_Click"/>
                <Button x:Name="AddProductButton"
            Content="Добавить товар"
            Margin="0,0,10,0"
            Click="AddProductButton_Click"/>
                <Button x:Name="EditProductButton"
            Content="Редактировать товар"
            Margin="0,0,10,0"
            Click="EditProductButton_Click"/>
                <Button x:Name="DeleteProductButton"
            Content="Удалить товар"
            Background="#B03A2E"
            Click="DeleteProductButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
