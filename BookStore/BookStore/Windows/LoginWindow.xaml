<Window x:Class="BookStore.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStore.Windows"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» - Авторизация"
        Height="520" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Image x:Name="LogoImage"
                       Height="54"
                       Stretch="Uniform"
                       Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ООО «ЧитайГород»"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Информационная система магазина"
                               FontSize="13"
                               Foreground="#222222"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="36,24,36,24" VerticalAlignment="Center">
            <TextBlock Text="Вход в систему"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Логин (Email):" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginTextBox" Height="38" Margin="0,0,0,14"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="38" Margin="0,0,0,22"/>

            <Button x:Name="LoginButton"
                    Content="Войти"
                    Height="42"
                    Margin="0,0,0,12"
                    Click="LoginButton_Click"/>

            <Button x:Name="GuestButton"
                    Content="Войти как гость"
                    Height="40"
                    Background="{StaticResource SecondaryBackgroundBrush}"
                    Foreground="#1A1A1A"
                    Click="GuestButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
