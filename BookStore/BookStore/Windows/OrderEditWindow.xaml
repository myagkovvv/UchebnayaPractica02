<Window x:Class="BookStore.Windows.OrderEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStore.Windows"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Карточка заказа"
        Height="610" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <TextBlock x:Name="HeaderTextBlock"
                       Text="Добавление заказа"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Артикул (Товар) *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ProductComboBox"
                                  SelectedValuePath="Id">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Article}" FontWeight="Bold"/>
                                        <Run Text=" — "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Количество *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="QuantityTextBox" Text="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Статус заказа *:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="StatusComboBox"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Margin="0,0,0,12"/>

                <TextBlock Text="Адрес пункта выдачи *:" FontWeight="Bold" Margin="0,0,0,4"/>
                <ComboBox x:Name="PickupPointComboBox"
                          DisplayMemberPath="DisplayAddress"
                          SelectedValuePath="Id"
                          Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Дата заказа *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="OrderDatePicker" FontFamily="Comic Sans MS" FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Дата выдачи *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <DatePicker x:Name="DeliveryDatePicker" FontFamily="Comic Sans MS" FontSize="14"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Клиент *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="ClientComboBox"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Код получения *:" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="PickupCodeTextBox"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Background="#777777"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
