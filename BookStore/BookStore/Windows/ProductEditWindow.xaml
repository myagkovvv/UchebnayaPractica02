<Window x:Class="BookStore.Windows.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookStore.Windows"
        mc:Ignorable="d"
        Title="ООО «ЧитайГород» — Карточка товара"
        Height="740" Width="780"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Background="{StaticResource PrimaryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <TextBlock x:Name="WindowHeaderTextBlock"
                       Text="Добавление товара"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Изображение (до 300×200):" FontWeight="Bold" Margin="0,0,0,6"/>
                    <Border Width="220" Height="160"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1.5"
                            Background="#FFFFFF"
                            Margin="0,0,0,10">
                        <Image x:Name="ProductPreviewImage" Stretch="Uniform"/>
                    </Border>
                    <Button x:Name="SelectImageButton"
                            Content="Выбрать фото..."
                            Margin="0,0,0,8"
                            Click="SelectImageButton_Click"/>
                    <Button x:Name="ClearImageButton"
                            Content="Сбросить фото"
                            Background="{StaticResource SecondaryBackgroundBrush}"
                            Foreground="#1A1A1A"
                            Click="ClearImageButton_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel x:Name="IdPanel" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Text="ID товара:" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox x:Name="IdTextBox" IsReadOnly="True" Background="#EEEEEE"/>
                    </StackPanel>

                    <TextBlock Text="Артикул *:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="ArticleTextBox" MaxLength="20" Margin="0,0,0,10"/>

                    <TextBlock Text="Наименование товара *:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameTextBox" MaxLength="300" Margin="0,0,0,10"/>

                    <TextBlock Text="Категория *:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                    <TextBlock Text="Производитель (Издательство) *:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="PublisherComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                    <TextBlock Text="Поставщик (Автор) *:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <ComboBox x:Name="AuthorComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Цена (руб.) *:" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox x:Name="PriceTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Единица измерения *:" FontWeight="Bold" Margin="0,0,0,3"/>
                            <ComboBox x:Name="UnitComboBox" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Количество на складе *:" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox x:Name="StockTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Действующая скидка (%):" FontWeight="Bold" Margin="0,0,0,3"/>
                            <TextBox x:Name="DiscountTextBox" Text="0"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Описание:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Height="80"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource SecondaryBackgroundBrush}" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Margin="0,0,10,0"
                        Click="SaveButton_Click"/>
                <Button x:Name="CancelButton"
                        Content="Отмена"
                        Background="#777777"
                        Click="CancelButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
